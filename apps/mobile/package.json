{
  "name": "@softek/mobile",
  "version": "0.2.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --go --port 8083",
    "start:tunnel": "expo start --go --tunnel --port 8083",
    "start:dev-client": "expo start --dev-client --tunnel --port 8083",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts && node --test tests/rendered/*.test.cjs",
    "export:ios": "expo export --platform ios --max-workers 1",
    "doctor": "npx expo-doctor@latest",
    "archive:check": "node scripts/check-archive.cjs",
    "eas": "node scripts/eas.cjs"
  },
  "dependencies": {
    "expo": "58.0.23",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-splash-screen": "~58.0.13",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-view-shot": "6.1.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@expo/ngrok": "4.1.3",
    "@types/react": "~19.3.0",
    "esbuild": "0.28.2",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  }
}

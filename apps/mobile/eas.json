{
  "cli": {
    "version": "25.2.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.21.1"
    },
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "node": "22.21.1",
      "env": { "EXPO_PUBLIC_CAPTURE_CHECK": "0" },
      "ios": { "buildConfiguration": "Release" }
    },
    "capture-check": {
      "extends": "preview",
      "env": { "EXPO_PUBLIC_CAPTURE_CHECK": "1" }
    }
  }
}

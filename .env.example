# Application database: use the username/password supplied in your private .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=demo
DB_USER=replace_with_application_username
DB_PASSWORD="replace_with_application_password"

# Bootstrap administration only; never use these in the application runtime.
# Keep administrative credentials separate from the DB_* runtime account.
ADMIN_DB_HOST=127.0.0.1
ADMIN_DB_PORT=3306
ADMIN_DB_USER=replace_with_admin_username
ADMIN_DB_PASSWORD="replace_with_admin_password"

# Separate schema migration and test accounts; provision with npm run db:provision.
MIGRATION_DB_USER=softek_migrator
MIGRATION_DB_PASSWORD="replace_with_migration_password"
TEST_DB_NAME=demo_test
TEST_DB_USER=softek_test_app
TEST_DB_PASSWORD="replace_with_test_password"

NODE_ENV=development
HOST=127.0.0.1
PORT=3101
CLARITY_ENABLED=false
VITE_CLARITY_ENABLED=false

# Strong random application secrets, stored only in private environment files.
SESSION_SECRET=replace_with_at_least_32_random_characters
DEMO_ADMIN_SECRET=replace_with_at_least_24_random_characters
AUTOMATION_SECRET=replace_with_random_harness_secret
PUBLIC_ORIGIN=http://127.0.0.1:5173
# Leave false until project, masking, consent, and hostname verification in M2.
CLARITY_CONFIG_VERIFIED=false
CLARITY_PROJECT_ID=

# Optional development asset directory; defaults to artifacts/banner-assets.
# Production is installed at /var/lib/softek/banner-assets; tests use a separate path.
# BANNER_ASSET_DIR=/absolute/path/to/banner-assets

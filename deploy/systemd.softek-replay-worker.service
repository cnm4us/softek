[Unit]
Description=Softek automatic recording video renderer
After=mariadb.service

[Service]
Type=simple
User=softek
Group=softek
WorkingDirectory=/opt/softek/current/apps/api
EnvironmentFile=/etc/softek/runtime.env
ExecStart=/opt/softek/runtime/bin/node /opt/softek/current/apps/api/dist/replay-worker.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
Nice=10
CPUQuota=150%
MemoryMax=1G
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/softek/recordings
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target

[Unit]
Description=Softek fictional banking API
After=network.target mariadb.service

[Service]
Type=simple
User=softek
Group=softek
WorkingDirectory=/opt/softek/current/apps/api
EnvironmentFile=/etc/softek/runtime.env
ExecStart=/opt/softek/runtime/bin/node /opt/softek/current/apps/api/dist/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/softek/banner-assets
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target

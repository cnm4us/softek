{
  "name": "softek",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @softek/api\" \"npm run dev -w @softek/web\"",
    "build": "tsx scripts/build.ts",
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.scripts.json",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:status": "tsx scripts/db.ts status",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:provision": "tsx scripts/provision-db.ts",
    "db:seed": "tsx scripts/seed.ts",
    "deploy": "tsx scripts/deploy.ts",
    "smoke:public": "tsx scripts/smoke-public.ts",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"db/seeds/*.ts\" \"playwright*.config.ts\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"db/seeds/*.ts\" \"playwright*.config.ts\"",
    "test:clarity": "playwright test -c playwright.clarity.config.ts",
    "clarity:pilot": "tsx scripts/clarity-pilot.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

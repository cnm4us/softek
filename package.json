{
  "name": "softek",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @softek/api\" \"npm run dev -w @softek/web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.scripts.json",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:status": "tsx scripts/db.ts status",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:provision": "tsx scripts/provision-db.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
